{
  "appId": "com.lostandsoundtravel.app",
  "appName": "Lost & Sound",
  "webDir": "out",
  "server": {
    "url": "https://www.lostandsoundtravel.com",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#853A51",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#853A51"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
